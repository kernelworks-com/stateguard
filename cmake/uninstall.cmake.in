set(manifest "@CMAKE_CURRENT_BINARY_DIR@/install_manifest.txt")
if(NOT EXISTS "${manifest}")
  message(FATAL_ERROR "No install manifest found. Install from this build first.")
endif()
file(STRINGS "${manifest}" installed_files)
foreach(installed_file IN LISTS installed_files)
  if(NOT IS_ABSOLUTE "${installed_file}")
    message(FATAL_ERROR "Install manifest contains a relative path")
  endif()
  set(target "$ENV{DESTDIR}${installed_file}")
  if(IS_DIRECTORY "${target}" AND NOT IS_SYMLINK "${target}")
    message(FATAL_ERROR "Refusing to remove a directory: ${target}")
  endif()
  if(EXISTS "${target}" OR IS_SYMLINK "${target}")
    file(REMOVE "${target}")
    if(EXISTS "${target}" OR IS_SYMLINK "${target}")
      message(FATAL_ERROR "Could not remove ${target}")
    endif()
  endif()
endforeach()
message(STATUS "Removed installed files; empty directories are retained")
